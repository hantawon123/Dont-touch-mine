              "ACCEPTED"
            ],
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "SendInviteRequest" : {
        "properties" : {
          "roomCode" : {
            "minLength" : 1,
            "pattern" : "^[0-9A-HJKMNPQRSTVWXYZ]{6}$",
            "type" : "string"
          },
          "userId" : {
            "maxLength" : 36,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [
          "roomCode",
          "userId"
        ],
        "type" : "object"
      },
