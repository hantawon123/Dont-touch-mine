          "roomCode" : {
            "type" : "string"
          },
          "userId" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "IssueAccountRequest" : {
        "properties" : {
          "deviceId" : {
            "maxLength" : 36,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [
          "deviceId"
        ],
        "type" : "object"
      },
      "SendFriendRequestRequest" : {
        "properties" : {
          "userId" : {
            "maxLength" : 36,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [
          "userId"
        ],
        "type" : "object"
      },
      "SendFriendRequestResponse" : {
        "properties" : {
          "status" : {
            "enum" : [
