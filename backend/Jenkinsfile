// 백엔드 파이프라인. Multibranch Pipeline이 브랜치와 MR별로 이 파일을 읽습니다.
//
// 하나의 파일이 두 경로를 처리합니다.
//
//   develop   대상 확인 → 빌드 → 테스트 → 기동 검증(운영 DB) → 배포 → 헬스체크
//   MR / 그 외  대상 확인 → 빌드 → 테스트 → 기동 검증(일회용 DB), 배포하지 않음
//
// 살아 있는 컨테이너를 교체하기 전에 새 이미지가 실제로 기동하는지 먼저 확인합니다.
// compose up 은 컨테이너를 먼저 교체하고 앱은 그 뒤에 뜨기 때문에, 곧바로 배포하면
// 마이그레이션 오류나 설정 오류가 곧 서비스 다운으로 이어집니다.
pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        // 같은 compose 프로젝트를 두 빌드가 동시에 건드리면 컨테이너가 꼬입니다.
        // Job 단위이므로 MR Job들끼리는 병렬로 돕니다. 검증 경로의 컨테이너 이름에
        // 빌드 번호를 넣어 서로 충돌하지 않게 했습니다.
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timestamps()
    }

    triggers {
        // 웹훅이 주 트리거입니다. 이건 웹훅이 실패했을 때의 안전망입니다.
        pollSCM('H/10 * * * *')
    }

    environment {
        COMPOSE_FILE = 'compose.prod.yml'
        HEALTH_URL   = 'http://localhost:8080/actuator/health'

        GITLAB_API      = 'https://lab.ssafy.com/api/v4'
        GITLAB_PROJECT  = 's15-metaverse-game-sub1%2FS15P21D205'

        // 배포 여부. BRANCH_NAME은 Multibranch에서만 설정되므로, 없으면 단독 Job이
        // Branch Specifier가 가리키는 develop을 빌드한다고 보고 배포합니다.
        //
        // when { branch 'develop' } 를 쓰면 단독 Job에서 조건이 false가 되어 배포가
        // 조용히 멈춥니다. 빌드는 초록불인데 배포가 안 되는 상태라 찾기 어렵습니다.
        DEPLOY = "${env.BRANCH_NAME == null || env.BRANCH_NAME == 'develop'}"

        // MR이면 대상 브랜치, 아니면 develop. 대상 확인의 비교 기준입니다.
        DIFF_BASE = "${env.CHANGE_TARGET ?: 'develop'}"

        // 검증 경로에서 만드는 자원들. 빌드 번호를 넣어 동시 빌드와 충돌하지 않게 합니다.
        VERIFY_TAG = "verify-${env.BUILD_NUMBER}"
        VERIFY_PFX = "d205-verify-${env.BUILD_NUMBER}"
    }

    stages {
        stage('대상 확인') {
            steps {
                // 배포 경로에도 적용합니다. Multibranch에는 Git 플러그인의 경로 필터
                // (Included Regions)가 없어서, 이게 없으면 Unity 커밋이 develop에
                // 머지될 때마다 백엔드가 빌드되고 컨테이너가 교체됩니다.
                sh '''
                    if [ "$DEPLOY" = true ]; then
                        # 이전 성공 빌드 이후의 변경만 봅니다. Jenkins가
                        # GIT_PREVIOUS_SUCCESSFUL_COMMIT을 주입합니다.
                        if [ -z "$GIT_PREVIOUS_SUCCESSFUL_COMMIT" ]; then
                            echo "이전 성공 빌드 정보가 없어 판별을 생략하고 빌드합니다."
                            exit 0
                        fi
                        if ! git cat-file -e "$GIT_PREVIOUS_SUCCESSFUL_COMMIT^{commit}" 2>/dev/null; then
                            echo "이전 성공 커밋을 찾을 수 없어 판별을 생략하고 빌드합니다."
                            exit 0
                        fi
                        range="$GIT_PREVIOUS_SUCCESSFUL_COMMIT..HEAD"
                    else
                        git fetch --no-tags origin "$DIFF_BASE:refs/remotes/origin/$DIFF_BASE" 2>/dev/null || true
                        range="origin/$DIFF_BASE...HEAD"
                    fi

                    changed=$(git diff --name-only "$range" -- backend/ | wc -l)
                    echo "backend/ 변경 파일: $changed 개 (기준: $range)"

                    if [ "$changed" -eq 0 ]; then
                        echo "backend/ 변경이 없어 이번 빌드는 할 일이 없습니다."
                        echo "SKIP" > .verify-skip
                    fi
                '''
                // 건너뛸 때 실패로 끝내면 안 됩니다. 머지 차단을 켜면 백엔드와 무관한
                // MR이 전부 머지 불가가 됩니다. 성공으로 보고하고 뒤 단계만 넘깁니다.
                script {
                    if (fileExists('.verify-skip')) {
                        env.SKIP_ALL = 'true'
                        currentBuild.description = 'backend/ 변경 없음 - 건너뜀'
                    }
                }
            }
        }

        stage('빌드') {
            when {
                allOf {
                    environment name: 'DEPLOY', value: 'true'
                    not { environment name: 'SKIP_ALL', value: 'true' }
                }
            }
            steps {
                // 워크스페이스는 git 체크아웃이라 .env가 없습니다. compose.prod.yml이
                // ${VAR:?} 를 쓰므로 build 명령에도 값이 필요합니다.
                withCredentials([file(credentialsId: 'd205-backend-env', variable: 'ENV_FILE')]) {
                    dir('backend') {
                        sh '''
                            cp "$ENV_FILE" .env
                            chmod 600 .env
                            docker compose -f "$COMPOSE_FILE" build

                            # 기동 검증이 실제 DB를 필요로 하므로 먼저 확인합니다.
                            docker compose -f "$COMPOSE_FILE" up -d --no-build mysql
                        '''
                    }
                }
            }
        }

        stage('빌드 (검증)') {
            when {
                allOf {
                    environment name: 'DEPLOY', value: 'false'
                    not { environment name: 'SKIP_ALL', value: 'true' }
                }
            }
            steps {
                dir('backend') {
                    // compose를 쓰지 않습니다. compose.prod.yml 파싱에 운영 환경변수가
                    // 필요하고, 남의 브랜치 빌드에 운영 크리덴셜을 줄 이유가 없습니다.
                    // 그리고 d205-app:latest 를 덮어쓰면 운영 태그가 오염됩니다.
                    sh 'docker build -t "d205-app:$VERIFY_TAG" .'
                }
            }
        }

        stage('테스트') {
            when { not { environment name: 'SKIP_ALL', value: 'true' } }
            steps {
                dir('backend') {
                    // Testcontainers가 mysql:8.4 컨테이너를 띄웁니다. 호스트 포트를
                    // 무작위로 잡고 Ryuk가 회수하므로 동시 빌드에서 충돌하지 않습니다.
                    sh '''
                        chmod +x gradlew
                        ./gradlew test --no-daemon --console=plain
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/build/test-results/test/*.xml'
                }
            }
        }

        stage('기동 검증 (운영 DB)') {
            when {
                allOf {
                    environment name: 'DEPLOY', value: 'true'
                    not { environment name: 'SKIP_ALL', value: 'true' }
                }
            }
            steps {
                dir('backend') {
                    sh '''
                        docker rm -f "$VERIFY_PFX-app" >/dev/null 2>&1 || true

                        NET=$(docker network ls --filter label=com.docker.compose.project=d205 --format '{{.Name}}' | head -1)
                        if [ -z "$NET" ]; then
                            echo "compose 네트워크를 찾지 못했습니다. mysql이 떠 있는지 확인하세요."
                            exit 1
                        fi
                        echo "네트워크: $NET"

                        # 비밀번호는 --env-file로 넘깁니다. -e DB_PASSWORD= 로 주면
                        # sh -x 트레이스에 값이 그대로 찍힙니다.
                        #
                        # 이 컨테이너가 Flyway를 돌려 운영 DB에 마이그레이션을 적용합니다.
                        # 빈 DB에서는 통과하지만 기존 데이터가 있으면 실패하는 경우를
                        # 여기서 잡습니다. 그래서 검증 경로와 달리 운영 DB를 씁니다.
                        #
                        # 호스트 포트는 0으로 두어 도커가 빈 포트를 고르게 합니다.
                        docker run -d --name "$VERIFY_PFX-app" \
                            --network "$NET" \
                            --env-file .env \
                            -e SPRING_PROFILES_ACTIVE=prod \
                            -e DB_HOST=mysql \
                            -e DB_PORT=3306 \
                            -e TZ=Asia/Seoul \
                            -p 127.0.0.1:0:8080 \
                            d205-app

                        PORT=$(docker port "$VERIFY_PFX-app" 8080 | head -1 | sed 's/.*://')
                        echo "임시 컨테이너 포트: $PORT"

                        set +x
                        ok=0
                        for i in $(seq 1 45); do
                            running=$(docker inspect -f '{{.State.Running}}' "$VERIFY_PFX-app" 2>/dev/null || echo false)
                            if [ "$running" != true ]; then
                                echo "임시 컨테이너가 종료되었습니다 (${i}회 시도)"
                                break
                            fi
                            if curl -fsS --max-time 3 "http://127.0.0.1:$PORT/actuator/health" 2>/dev/null | grep -q '"status":"UP"'; then
                                echo "기동 검증 통과 (${i}회 시도)"
                                ok=1
                                break
                            fi
                            sleep 2
                        done
                        set -x

                        if [ "$ok" != 1 ]; then
                            echo "기동 검증 실패 - 살아 있는 컨테이너는 교체하지 않았습니다"
                            docker logs "$VERIFY_PFX-app" --tail 120 2>&1 || true
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('기동 검증 (일회용 DB)') {
            when {
                allOf {
                    environment name: 'DEPLOY', value: 'false'
                    not { environment name: 'SKIP_ALL', value: 'true' }
                }
            }
            steps {
                dir('backend') {
                    // 운영 DB를 건드릴 수 없으므로 MySQL을 새로 띄웁니다. 접속 정보도
                    // 여기서 만들어 씁니다. 운영 크리덴셜은 이 경로에 들어오지 않습니다.
                    sh '''
                        NET="$VERIFY_PFX-net"
                        DB="$VERIFY_PFX-mysql"
                        APP="$VERIFY_PFX-app"

                        set +x
                        PW=$(tr -dc A-Za-z0-9 < /dev/urandom | head -c 24)
                        set -x

                        docker network create "$NET"

                        set +x
                        docker run -d --name "$DB" --network "$NET" \
                            -e MYSQL_ROOT_PASSWORD="$PW" \
                            -e MYSQL_DATABASE=d205 \
                            -e MYSQL_USER=d205 \
                            -e MYSQL_PASSWORD="$PW" \
                            -e TZ=Asia/Seoul \
                            mysql:8.4 \
                            --character-set-server=utf8mb4 \
                            --collation-server=utf8mb4_0900_ai_ci > /dev/null
                        set -x

                        set +x
                        echo "MySQL 준비 대기"
                        db_ok=0
                        for i in $(seq 1 40); do
                            if docker exec "$DB" mysqladmin ping -h 127.0.0.1 --silent >/dev/null 2>&1; then
                                echo "MySQL 준비됨 (${i}회 시도)"
                                db_ok=1
                                break
                            fi
                            sleep 2
                        done
                        if [ "$db_ok" != 1 ]; then
                            echo "일회용 MySQL이 준비되지 않았습니다"
                            docker logs "$DB" --tail 50 2>&1 || true
                            exit 1
                        fi

                        docker run -d --name "$APP" --network "$NET" \
                            -e SPRING_PROFILES_ACTIVE=prod \
                            -e DB_HOST="$DB" \
                            -e DB_PORT=3306 \
                            -e DB_NAME=d205 \
                            -e DB_USERNAME=d205 \
                            -e DB_PASSWORD="$PW" \
                            -e TZ=Asia/Seoul \
                            -p 127.0.0.1:0:8080 \
                            "d205-app:$VERIFY_TAG" > /dev/null
                        set -x

                        PORT=$(docker port "$APP" 8080 | head -1 | sed 's/.*://')
                        echo "임시 컨테이너 포트: $PORT"

                        set +x
                        ok=0
                        for i in $(seq 1 45); do
                            running=$(docker inspect -f '{{.State.Running}}' "$APP" 2>/dev/null || echo false)
                            if [ "$running" != true ]; then
                                echo "임시 컨테이너가 종료되었습니다 (${i}회 시도)"
                                break
                            fi
                            if curl -fsS --max-time 3 "http://127.0.0.1:$PORT/actuator/health" 2>/dev/null | grep -q '"status":"UP"'; then
                                echo "기동 검증 통과 (${i}회 시도)"
                                ok=1
                                break
                            fi
                            sleep 2
                        done
                        set -x

                        if [ "$ok" != 1 ]; then
                            echo "기동 검증 실패"
                            docker logs "$APP" --tail 120 2>&1 || true
                            exit 1
                        fi
                    '''
                }
            }
        }

        stage('배포') {
            when {
                allOf {
                    environment name: 'DEPLOY', value: 'true'
                    not { environment name: 'SKIP_ALL', value: 'true' }
                }
            }
            steps {
                dir('backend') {
                    sh '''
                        # 임시 컨테이너를 먼저 치웁니다. 남겨두면 같은 DB에 계속 붙어 있습니다.
                        docker rm -f "$VERIFY_PFX-app" >/dev/null 2>&1 || true

                        # 이미지는 이미 빌드됐고 기동도 확인됐습니다. 여기서는 교체만 합니다.
                        docker compose -f "$COMPOSE_FILE" up -d --remove-orphans
                    '''
                }
            }
        }

        stage('헬스체크') {
            when {
                allOf {
                    environment name: 'DEPLOY', value: 'true'
                    not { environment name: 'SKIP_ALL', value: 'true' }
                }
            }
            steps {
                dir('backend') {
                    // 기동 검증을 통과했으니 여기서 실패하는 것은 교체 과정의 문제입니다.
                    sh '''
                        set +x
                        for i in $(seq 1 30); do
                            if curl -fsS --max-time 3 "$HEALTH_URL" 2>/dev/null | grep -q '"status":"UP"'; then
                                echo "헬스체크 통과 (${i}회 시도)"
                                exit 0
                            fi
                            sleep 2
                        done
                        set -x

                        echo "헬스체크 실패 - 60초 안에 UP이 되지 않았습니다"
                        docker compose -f "$COMPOSE_FILE" ps || true
                        docker compose -f "$COMPOSE_FILE" logs app --tail 100 || true
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        success {
            script {
                // develop이 갱신되면 열려 있는 MR들의 초록불은 낡은 것이 됩니다.
                // 그 MR은 "이전 develop에 합친 결과"로 검증받았기 때문입니다.
                // GitLab Free에는 merged results pipeline과 merge train이 없어
                // 자동 재검증이 일어나지 않습니다. 그래서 여기서 직접 요청합니다.
                //
                // 커밋 상태를 직접 게시하지 않는 이유: GitLab은 상태를 (SHA, 컨텍스트)
                // 쌍으로 관리하므로, 플러그인과 다른 컨텍스트로 pending을 올리면
                // 그 상태가 영구히 남아 머지가 영원히 잠깁니다. 재빌드를 요청하면
                // 플러그인이 스스로 pending을 올리고(즉시 잠김) 완료 후 갱신합니다.
                //
                // backend/ 변경이 없어 건너뛴 빌드에서는 하지 않습니다. MR의 백엔드
                // 검증 결과가 달라질 이유가 없기 때문입니다.
                if (env.DEPLOY == 'true' && env.SKIP_ALL != 'true') {
                    // gitlab-api-token 이 아니라 -text 입니다. GitLab 플러그인의 토큰
                    // 크리덴셜은 StringCredentials가 아니어서 파이프라인의 string()
                    // 바인딩으로 읽을 수 없습니다. 같은 토큰을 Secret text로 한 번 더
                    // 등록해 씁니다. 갱신할 때 두 개를 모두 고쳐야 합니다.
                    try {
                        withCredentials([string(credentialsId: 'gitlab-api-token-text', variable: 'GL_TOKEN')]) {
                            def raw = sh(returnStdout: true, script: '''
                                set +x
                                curl -fsS -H "PRIVATE-TOKEN: $GL_TOKEN" "$GITLAB_API/projects/$GITLAB_PROJECT/merge_requests?state=opened&target_branch=develop&per_page=100" | jq -r '.[].iid'
                            ''').trim()

                            def folder = env.JOB_NAME.contains('/') ? env.JOB_NAME.split('/')[0] : null
                            def iids = raw ? raw.split('\\s+') : []
                            echo "develop 대상 열린 MR: ${iids.size()} 개"

                            if (folder == null) {
                                echo '단독 Job이라 MR Job을 찾을 수 없어 재검증 요청을 생략합니다.'
                            } else {
                                for (iid in iids) {
                                    def target = "${folder}/MR-${iid}"
                                    try {
                                        build job: target, wait: false, propagate: false
                                        echo "  ${target} 재빌드 요청 (develop 갱신 반영)"
                                    } catch (err) {
                                        echo "  ${target} 트리거 실패: ${err.message}"
                                    }
                                }
                            }
                        }
                    } catch (err) {
                        // 배포는 이미 끝났으므로 빌드를 실패로 만들지는 않습니다.
                        // 다만 조용히 넘기면 무효화가 동작하지 않는 것을 아무도
                        // 모르게 되므로 UNSTABLE로 눈에 띄게 남깁니다.
                        echo "열린 MR 재검증 요청 실패: ${err.message}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
        always {
            dir('backend') {
                // 이 빌드가 만든 자원만 지웁니다. 이름에 빌드 번호가 들어 있어
                // 동시에 도는 다른 빌드의 컨테이너를 건드리지 않습니다.
                sh '''
                    docker rm -f $(docker ps -aq --filter "name=$VERIFY_PFX-") 2>/dev/null || true
                    docker network rm "$VERIFY_PFX-net" 2>/dev/null || true
                    docker image rm -f "d205-app:$VERIFY_TAG" 2>/dev/null || true
                    rm -f .env .verify-skip
                    docker builder prune -f --filter until=168h || true
                '''
            }
        }
        failure {
            echo '''파이프라인 실패. 서비스 상태는 어느 단계에서 실패했는지에 달려 있습니다.

  대상 확인 / 빌드 / 테스트 / 기동 검증  -> 운영 컨테이너를 교체하지 않았으므로 서비스는 정상입니다.
  배포 / 헬스체크                        -> 컨테이너가 이미 교체되었으므로 서비스가 내려간 상태일 수 있습니다.

확인: ssh d205 'bash /var/lib/jenkins/workspace/d205-backend_develop/backend/deploy/verify.sh'
복구 절차는 backend/deploy/README.md 를 참고하세요.'''
        }
    }
}
